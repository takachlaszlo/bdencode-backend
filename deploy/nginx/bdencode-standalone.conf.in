server {
    listen 127.0.0.1:@LISTEN_PORT@ default_server;
    server_name _;
    return 444;
}

server {
    listen 127.0.0.1:@LISTEN_PORT@;
    server_name localhost 127.0.0.1;

    location = / {
        return 302 /encoder/;
    }

    location = /encoder {
        return 301 /encoder/;
    }

    location ^~ /encoder/api/ {
        proxy_pass http://127.0.0.1:@BACKEND_PORT@/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /encoder;
        # This listener is loopback-only. Bind the publication audit identity
        # at the trusted proxy boundary, never in a browser request body.
        proxy_set_header X-Remote-User local-wsl-operator;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        client_max_body_size 1m;

        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
    }

    location /encoder/ {
        root @FRONTEND_ROOT@;
        try_files $uri $uri/ /encoder/index.html =404;

        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'" always;
    }
}
